<configuration>
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <!-- thread name is printed on purpose: Phase 1 is all about which thread runs what -->
            <pattern>%d{HH:mm:ss.SSS} [%-22thread] %-5level %logger{20} - %msg%n</pattern>
        </encoder>
    </appender>

    <logger name="reactor" level="WARN"/>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>
